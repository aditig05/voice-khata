# Copy this file to .env and paste your key. Never commit .env.
SARVAM_API_KEY=your_sarvam_api_key_here
PORT=3000
# Optional
# TTS_SPEAKER=priya
# RATE_LIMIT_PER_10_MIN=40
# Free fallbacks, used automatically when Sarvam fails (e.g. credits used up). Optional.
GROQ_API_KEY=
GEMINI_API_KEY=
# auto (Sarvam first, then free) | free (skip Sarvam) | sarvam (no fallback)
AI_PROVIDER=auto
